  "acceptance": [
    {
      "id": "process.map",
      "text": "事業の地図に、事業の柱・工程・成果物・項目が枝として並び、工程ごとに確かめる人がメモにある。",
      "checkedBy": "AI",
      "target": "business-map"
    },
    {
      "id": "process.check",
      "text": "工程定義の下書きが open-workflow-definitions の検査を通り、どの工程・成果物も事業の地図の枝に結び付いている。",
      "checkedBy": "AI",
      "target": "definition-draft"
    },
    {
      "id": "process.approved",
      "text": "早川が事業の地図と工程定義を読み、この定義で企画を進めると承認する。",
      "checkedBy": "人",
      "target": "definition-draft"
    },
    {
      "id": "opportunity.review1",
      "text": "早川が機会の地図を承認する。",
      "checkedBy": "人",
      "target": "opportunity-map"
    },
    {
      "id": "hypothesis.review1",
      "text": "早川が事業の仮説を承認し、石田が数字の出所を確認する。",
      "checkedBy": "人",
      "target": "business-hypothesis"
    },
    {
      "id": "market.review1",
      "text": "石田が市場と顧客の調べを承認する。",
      "checkedBy": "人",
      "target": "market-research"
    },
    {
      "id": "market.review2",
      "text": "G1 企画会議：ここまでで続けるか決める。",
      "checkedBy": "人",
      "target": "market-research"
    },
    {
      "id": "business-model.review1",
      "text": "早川が事業モデルの地図を承認する。",
      "checkedBy": "人",
      "target": "business-model-map"
    },
    {
      "id": "execution.review1",
      "text": "中川が体制・システムを確認する。",
      "checkedBy": "人",
      "target": "execution-plan"
    },
    {
      "id": "financial-plan.review1",
      "text": "佐藤が経理の観点から収支のモデルを承認する。",
      "checkedBy": "人",
      "target": "financial-model"
    },
    {
      "id": "risk.review1",
      "text": "法務の担当がリスクの表を承認する。",
      "checkedBy": "人",
      "target": "risk-table"
    },
    {
      "id": "investment.review1",
      "text": "G2 投資委員会で財務の佐藤と法務の担当の両方が投資の判断を承認する。",
      "checkedBy": "人",
      "target": "investment-record"
    },
    {
      "id": "business-plan.review1",
      "text": "早川が事業計画書を承認する。",
      "checkedBy": "人",
      "target": "business-plan-document"
    },
    {
      "id": "presentation.review1",
      "text": "早川がアニメーション付きのスライドを承認する。",
      "checkedBy": "人",
      "target": "presentation-slides"
    },
    {
      "id": "management-decision.review1",
      "text": "G3 経営会議で早川が説明し、経営会議が経営の判断を承認する。",
      "checkedBy": "人",
      "target": "management-record"
    },
    {
      "id": "learning.review1",
      "text": "早川が学びの記録を承認する。",
      "checkedBy": "人",
      "target": "learning-record"
    },
    {
      "id": "opportunity.content",
      "text": "機会と顧客の困りごとがそれぞれ記載されている。",
      "checkedBy": "AI",
      "target": "opportunity-map"
    },
    {
      "id": "hypothesis.content",
      "text": "どの仮説にも確かめ方があり、市場の大きさまたは前提を1件以上引用する。後工程で市場の大きさや前提を作成した際にも引用を補い確認する。",
      "checkedBy": "AI",
      "target": "business-hypothesis",
      "rules": [
        "hypothesis.evidence"
      ]
    },
    {
      "id": "market.content",
      "text": "市場の大きさには出所を記し、出所がない場合は「仮定」と記す。顧客の区分が記載されている。",
      "checkedBy": "AI",
      "target": "market-research"
    },
    {
      "id": "business-model.content",
      "text": "価値の流れと収益の柱がそれぞれ記載されている。",
      "checkedBy": "AI",
      "target": "business-model-map"
    },
    {
      "id": "execution.content",
      "text": "体制と日程の節目がそれぞれ記載されている。",
      "checkedBy": "AI",
      "target": "execution-plan"
    },
    {
      "id": "financial-plan.content",
      "text": "収支は10年・年次・3シナリオでNPVとIRRを示す。前提には実績・予測・仮定・計算の種類を付け、為替（THB）を置く。各シナリオは前提を引用する。",
      "checkedBy": "AI",
      "target": "financial-model",
      "rules": [
        "scenario.assumption"
      ]
    },
    {
      "id": "risk.content",
      "text": "どのリスクも対策に引用され、覆われている。",
      "checkedBy": "AI",
      "target": "risk-table",
      "rules": [
        "mitigation.risk",
        "risk.covered"
      ]
    },
    {
      "id": "investment.content",
      "text": "どの判断の条件も前提またはリスクを引用する。",
      "checkedBy": "AI",
      "target": "investment-record",
      "rules": [
        "criterion.basis"
      ]
    },
    {
      "id": "business-plan.content",
      "text": "事業計画書に章が記載されている。",
      "checkedBy": "AI",
      "target": "business-plan-document"
    },
    {
      "id": "presentation.content",
      "text": "どのスライドも事業計画書の章を引用する。",
      "checkedBy": "AI",
      "target": "presentation-slides",
      "rules": [
        "slide.chapter"
      ]
    },
    {
      "id": "management-decision.content",
      "text": "どの経営の判断も判断の条件を引用する。",
      "checkedBy": "AI",
      "target": "management-record",
      "rules": [
        "decision.criterion"
      ]
    },
    {
      "id": "learning.content",
      "text": "学びが記載されている。",
      "checkedBy": "AI",
      "target": "learning-record"
    }
  ],
  "rules": [
