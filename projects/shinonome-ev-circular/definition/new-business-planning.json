{
  "format": 1,
  "id": "new-business-planning",
  "version": "1.0.0",
  "title": "新規事業の企画",
  "purpose": "事業機会を見立て、事業計画を組み立て、投資と経営の判断を経て学びを残す。",
  "phases": [
    {
      "id": "process",
      "name": "進め方",
      "purpose": "事業の地図（柱→工程→成果物→項目）をマインドマップで描き、それをもとに工程定義の JSON を作り、検査を通して承認する。",
      "after": [],
      "deliverables": [
        "business-map",
        "definition-draft"
      ],
      "acceptance": [
        "process.map",
        "process.check",
        "process.approved"
      ]
    },
    {
      "id": "opportunity",
      "name": "機会の探索",
      "purpose": "機会の地図をまとめる。",
      "after": [
        "process"
      ],
      "deliverables": [
        "opportunity-map"
      ],
      "acceptance": [
        "opportunity.review1",
        "opportunity.content"
      ]
    },
    {
      "id": "hypothesis",
      "name": "事業の仮説",
      "purpose": "事業の仮説をまとめる。",
      "after": [
        "opportunity"
      ],
      "deliverables": [
        "business-hypothesis"
      ],
      "acceptance": [
        "hypothesis.review1",
        "hypothesis.content"
      ]
    },
    {
      "id": "market",
      "name": "市場と顧客",
      "purpose": "市場と顧客の調べをまとめる。",
      "after": [
        "hypothesis"
      ],
      "deliverables": [
        "market-research"
      ],
      "acceptance": [
        "market.review1",
        "market.review2",
        "market.content"
      ]
    },
    {
      "id": "business-model",
      "name": "事業モデル",
      "purpose": "事業モデルの地図をまとめる。",
      "after": [
        "market"
      ],
      "deliverables": [
        "business-model-map"
      ],
      "acceptance": [
        "business-model.review1",
        "business-model.content"
      ]
    },
    {
      "id": "execution",
      "name": "実行の計画",
      "purpose": "実行の計画をまとめる。",
      "after": [
        "business-model"
      ],
      "deliverables": [
        "execution-plan"
      ],
      "acceptance": [
        "execution.review1",
        "execution.content"
      ]
    },
    {
      "id": "financial-plan",
      "name": "収支計画",
      "purpose": "収支のモデル（NPV・IRR、3つのシナリオ、10年・年次）をまとめる。",
      "after": [
        "execution"
      ],
      "deliverables": [
        "financial-model"
      ],
      "acceptance": [
        "financial-plan.review1",
        "financial-plan.content"
      ]
    },
    {
      "id": "risk",
      "name": "リスクと対策",
      "purpose": "リスクの表をまとめる。",
      "after": [
        "financial-plan"
      ],
      "deliverables": [
        "risk-table"
      ],
      "acceptance": [
        "risk.review1",
        "risk.content"
      ]
    },
    {
      "id": "investment",
      "name": "投資の判断",
      "purpose": "投資の判断の記録をまとめる。",
      "after": [
        "risk"
      ],
      "deliverables": [
        "investment-record"
      ],
      "acceptance": [
        "investment.review1",
        "investment.content"
      ]
    },
    {
      "id": "business-plan",
      "name": "事業計画書",
      "purpose": "事業計画書をまとめる。",
      "after": [
        "investment"
      ],
      "deliverables": [
        "business-plan-document"
      ],
      "acceptance": [
        "business-plan.review1",
        "business-plan.content"
      ]
    },
    {
      "id": "presentation",
      "name": "説明の資料",
      "purpose": "アニメーション付きのスライドをまとめる。",
      "after": [
        "business-plan"
      ],
      "deliverables": [
        "presentation-slides"
      ],
      "acceptance": [
        "presentation.review1",
        "presentation.content"
      ]
    },
    {
      "id": "management-decision",
      "name": "経営の判断",
      "purpose": "経営の判断の記録をまとめる。",
      "after": [
        "presentation"
      ],
      "deliverables": [
        "management-record"
      ],
      "acceptance": [
        "management-decision.review1",
        "management-decision.content"
      ]
    },
    {
      "id": "learning",
      "name": "学び",
      "purpose": "学びの記録をまとめる。",
      "after": [
        "management-decision"
      ],
      "deliverables": [
        "learning-record"
      ],
      "acceptance": [
        "learning.review1",
        "learning.content"
      ]
    }
  ],
  "sections": [
    {
      "id": "start",
      "name": "はじめる",
      "phases": [
        "process"
      ]
    },
    {
      "id": "assess",
      "name": "見立てる",
      "phases": [
        "opportunity",
        "hypothesis",
        "market"
      ]
    },
    {
      "id": "build",
      "name": "組み立てる",
      "phases": [
        "business-model",
        "execution",
        "financial-plan",
        "risk"
      ]
    },
    {
      "id": "decide",
      "name": "決める",
      "phases": [
        "investment",
        "business-plan",
        "presentation",
        "management-decision"
      ]
    },
    {
      "id": "reflect",
      "name": "振り返る",
      "phases": [
        "learning"
      ]
    }
  ],
